# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/doodlea?sslmode=require"

# NextAuth Configuration
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Application URL
# Development: http://localhost:3050
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3050"
NEXT_PUBLIC_APP_URL="http://localhost:3050"

# Google OAuth (Optional)
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# UploadThing (for file uploads)
UPLOADTHING_TOKEN="your-uploadthing-token"

# Inngest (background job processing)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# Polar (payments & subscriptions)
# Get from: https://polar.sh → Settings → Developers → Personal Access Tokens
POLAR_ACCESS_TOKEN="polar_oat_..."
# Get from: https://polar.sh → Settings → Webhooks → (your webhook) → Secret
POLAR_WEBHOOK_SECRET="polar_whs_..."
# Product IDs from your Polar dashboard → Products
POLAR_STANDARD_PLAN="your-standard-product-id-here"
POLAR_PRO_PLAN="your-pro-product-id-here"
